{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanlew1.github.io/ai-agent-project-governance/schemas/verification_result.schema.json",
  "title": "Governance Verification Result",
  "description": "Normalized outcome of scope, operation, and test verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "scope_check",
    "forbidden_operation_check",
    "tests",
    "completion_status",
    "remaining_risks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_check": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "forbidden_operation_check": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "level", "required", "status", "summary", "exit_code", "duration_ms", "stdout_digest", "stderr_digest", "redaction_count", "redaction_rule_version"],
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "TIMEOUT",
              "ERROR"
            ]
          },
          "required": {"type": "boolean"},
          "summary": {
            "type": "string"
          },
          "exit_code": {"type": ["integer", "null"]},
          "duration_ms": {"type": "integer", "minimum": 0},
          "stdout_digest": {"type": ["string", "null"]},
          "stderr_digest": {"type": ["string", "null"]},
          "redaction_count": {"type": "integer", "minimum": 0},
          "redaction_rule_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "completion_status": {
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guard_status": {
      "enum": [
        "PASS",
        "WARN",
        "BLOCKED",
        "ERROR"
      ]
    },
    "test_plan_status": {
      "enum": [
        "READY",
        "DRAFT",
        "BLOCKED"
      ]
    },
    "required_tests_passed": {
      "type": "boolean"
    },
    "optional_tests_passed": {
      "type": "boolean"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "orchestration_id": {"type":"string", "minLength":1},
    "baseline_failures": {"type":"array", "items":{"type":"string"}},
    "post_task_failures": {"type":"array", "items":{"type":"string"}},
    "task_created_failures": {"type":"array", "items":{"type":"string"}},
    "closure_state": {"enum":["TASK_VERIFIED", "REPOSITORY_BASELINE_DEGRADED", "NO_NEW_FAILURE", "TASK_FAILURE"]},
    "evidence_binding": {"$ref":"#/$defs/task_relevance_evidence"}
  },
  "$defs": {
    "compact_test": {
      "type":"object", "additionalProperties":false,
      "required":["command_id","status","required","reason","stdout_digest","stderr_digest","redaction_count","redaction_rule_version"],
      "properties": {
        "command_id":{"type":"string","minLength":1}, "status":{"enum":["PASS","FAIL","NOT_RUN","TIMEOUT","ERROR"]}, "required":{"type":"boolean"},
        "reason":{"enum":["task_relevant","affected_module_regression"]}, "stdout_digest":{"type":["string","null"]}, "stderr_digest":{"type":["string","null"]},
        "redaction_count":{"type":"integer","minimum":0}, "redaction_rule_version":{"type":"string","minLength":1}
      }
    },
    "task_relevance_evidence": {
      "type":"object", "additionalProperties":false,
      "required":["task_id","required_tests","regression_tests","required_tests_satisfied","failure_isolation","evidence_digest"],
      "properties": {
        "task_id":{"type":"string","minLength":1}, "required_tests":{"type":"array","items":{"$ref":"#/$defs/compact_test"}},
        "regression_tests":{"type":"array","items":{"$ref":"#/$defs/compact_test"}}, "required_tests_satisfied":{"type":"boolean"},
        "failure_isolation":{"type":"object","additionalProperties":false,"required":["baseline_failures","post_task_failures","task_created_failures","closure_state"],"properties":{"baseline_failures":{"type":"array","items":{"type":"string"}},"post_task_failures":{"type":"array","items":{"type":"string"}},"task_created_failures":{"type":"array","items":{"type":"string"}},"closure_state":{"enum":["TASK_VERIFIED","REPOSITORY_BASELINE_DEGRADED","NO_NEW_FAILURE","TASK_FAILURE"]}}},
        "evidence_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    }
  }
}
