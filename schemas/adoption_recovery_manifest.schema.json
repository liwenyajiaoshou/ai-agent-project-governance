{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://vanlew1.github.io/ai-agent-project-governance/schemas/adoption_recovery_manifest.schema.json","title":"Adoption Recovery Manifest","description":"Exact-byte successor and bounded recovery writeset for an activated Runtime.","type":"object","required":["schema_version","artifact_type","target_identity_digest","expected_state","old_task_digest","old_state_digest","successor_task_digest","successor_task","scope_delta","writeset","installation_receipt_digest","activation_receipt_digest","upstream_evidence_digests","manifest_digest"],"properties":{"schema_version":{"const":"1.0"},"artifact_type":{"const":"ADOPTION_TASK_CONTRACT_RECOVERY"},"target_identity_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"expected_state":{"const":"ACTIVATED_NOT_PREFLIGHTED"},"old_task_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"old_state_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"successor_task_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"successor_task":{"type":"object"},"scope_delta":{"type":"array","items":{"type":"string"}},"writeset":{"const":["task.yaml","project_state.yaml"]},"installation_receipt_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"activation_receipt_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"upstream_evidence_digests":{"type":"array","items":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"manifest_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}
