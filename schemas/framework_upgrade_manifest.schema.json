{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://vanlew1.github.io/ai-agent-project-governance/schemas/framework_upgrade_manifest.schema.json","title":"Framework Upgrade Manifest","description":"Changed-only v1.5.1-to-v1.5.2 framework asset preview.","type":"object","required":["schema_version","artifact_type","from_version","to_version","source_commit","target_identity_digest","assets","writeset","preserved_paths","manifest_digest"],"properties":{"schema_version":{"const":"1.0"},"artifact_type":{"const":"FRAMEWORK_UPGRADE"},"from_version":{"const":"1.5.1"},"to_version":{"const":"1.5.2"},"source_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"target_identity_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"assets":{"type":"array","items":{"type":"object"}},"writeset":{"type":"array","items":{"type":"string"}},"preserved_paths":{"const":["project_state.yaml","task.yaml"]},"manifest_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}
