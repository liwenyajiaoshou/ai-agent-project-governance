{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/extensions/context-handoff/current_state_snapshot.schema.json",
  "title": "Context Handoff Current State Snapshot",
  "description": "Derived optional state view; never an authorization or completion record.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "project_name", "task_id", "report_type", "task_status", "repository", "branch", "head", "worktree_status", "verification_status", "final_status", "blockers", "next_gate", "next_action", "authoritative_files", "supersedes", "superseded_by", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "project_id": {"type": "string", "minLength": 1}, "project_name": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "report_type": {"const": "CURRENT_STATE_SNAPSHOT"},
    "task_status": {"enum": ["UNKNOWN", "DRAFT", "READY", "BLOCKED", "EXECUTION_COMPLETED", "CLOSED", "CONFLICT_REQUIRES_REVIEW"]}, "repository": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "head": {"type": "string", "minLength": 1}, "worktree_status": {"enum": ["CLEAN", "DIRTY", "UNKNOWN"]},
    "verification_status": {"enum": ["UNKNOWN", "PASS", "FAIL", "CONFLICT_REQUIRES_REVIEW"]}, "final_status": {"enum": ["UNKNOWN", "LOCAL_ONLY", "REMOTE_MERGED", "RELEASED", "CONFLICT_REQUIRES_REVIEW"]}, "blockers": {"type": "array", "items": {"type": "string"}}, "next_gate": {"type": "string", "minLength": 1}, "next_action": {"type": "string", "minLength": 1}, "authoritative_files": {"type": "array", "items": {"type": "string"}}, "supersedes": {"type": ["string", "null"]}, "superseded_by": {"type": ["string", "null"]}, "generated_at": {"type": "string", "minLength": 1},
    "pr_url": {"type": "string"}, "merge_commit": {"type": "string"}, "release_status": {"type": "string"}, "deployment_status": {"type": "string"}, "external_api_requests": {"type": "integer", "minimum": 0}, "production_writes": {"type": "integer", "minimum": 0}, "database_writes": {"type": "integer", "minimum": 0}
  }
}
